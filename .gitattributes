# KiCad PCB layout files are huge S-expression blobs where even small edits
# touch enormous coordinate/geometry blocks. Mark generated/fab output so
# GitHub (and Copilot's PR review, which has a hard line-count cap) treats
# them as generated/binary rather than diffable text.
*.kicad_pcb linguist-generated diff=kicad_pcb
*.kicad_prl linguist-generated
*.kicad_dru linguist-generated

# Raw Gerber/drill/pick-and-place fabrication output — always regenerated by
# kicad-cli from the source .kicad_pcb, never hand-edited.
*.gbr linguist-generated -diff
*.gbrjob linguist-generated -diff
*.drl linguist-generated -diff
*.pho linguist-generated -diff

# Everything under changelog/gerber_*/ is an old-vs-new fabrication diff
# snapshot, not source — exclude from PR line-diffing entirely.
changelog/gerber_*/** linguist-generated -diff

# Generated reports/exports — regenerated by kicad-cli, reviewed as
# artifacts/attachments rather than line-by-line diffs.
*.rpt linguist-generated -diff

# Rendered PNGs (KiCad exports, tools/gerber-diff output, etc.) — always
# generated from source files, reviewed visually as images/attachments,
# never diffed as content.
*.png linguist-generated -diff
